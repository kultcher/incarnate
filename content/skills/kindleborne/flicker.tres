[resource]
script = ExtResource("5_an6j2")
id = &"flicker"
display_name = "Flicker"
icon = ExtResource("4_coimh")
description = "Free, once (after Flickerstep). Teleport to an empty square within the range Flickerstep drew."
slot = 4
cost = 2
tags = Array[StringName]([&"teleport"])
targets = Array[ExtResource("6_plwj4")]([SubResource("Resource_4dov4")])
effects = Array[ExtResource("1_nr6uq")]([SubResource("Resource_we6wa")])
