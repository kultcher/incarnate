[sub_resource type="Resource" id="Resource_we6wa"]
script = ExtResource("2_ecaom")
unit_step = -1
dest_step = 0
consume_status = &"flicker"

[sub_resource type="Resource" id="Resource_vi4m5"]
script = ExtResource("7_eje5l")

[sub_resource type="Resource" id="Resource_4dov4"]
script = ExtResource("6_plwj4")
highlight = 1
