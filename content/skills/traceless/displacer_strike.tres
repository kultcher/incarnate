display_name = "Displacer Strike"
icon = ExtResource("5_fu43h")
description = "Shift up to {shift} squares, through foes if you like. Before or after the shift, strike an adjacent foe for {damage}. (Pick your own square to strike without moving.) Shadows inherit it; a Shadow using it shifts 2 squares further."
