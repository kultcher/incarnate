[resource]
script = ExtResource("5_bp3ll")
id = &"rising_heat"
display_name = "Rising Heat"
icon = ExtResource("4_85qi3")
description = "Passive. Each skill you use that costs an action adds 1 Heat (up to {max}); Ignited skills and Burnout replays add none. Use Stoke (free) to spend Heat: Ignite ({ignite} Heat, 1 more for each Ignite this turn) makes your next skill this turn free; Dissipate ({dissipate} Heat) heals you and gives +1 Evasion this turn."
tags = Array[StringName]([&"passive"])
show_on_unit = false
behavior = SubResource("Resource_g7m16")
