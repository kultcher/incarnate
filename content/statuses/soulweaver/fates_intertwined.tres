[resource]
script = ExtResource("8_txqyu")
id = &"fates_intertwined"
display_name = "Fates Intertwined"
icon = ExtResource("7_3xoy0")
description = "Passive. At the start of your turn, flip the top Soulstream card: its suit's Infusion activates for you and your Tethered ally (and for an ally you Tether later this turn). Blade: Potent (a free basic attack). Ward: Stalwart (shield 1). Orb: Sage (recharge a skill). Portal: Elusive (shift 2). A two-suit card brings both; a Wild lets you pick. Use Tether (free, once per turn) to choose your ally."
tags = Array[StringName]([&"passive"])
show_on_unit = false
behavior = SubResource("Resource_x1cwv")
