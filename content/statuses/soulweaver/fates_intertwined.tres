[resource]
script = ExtResource("8_txqyu")
id = &"fates_intertwined"
display_name = "Fates Intertwined"
icon = ExtResource("7_3xoy0")
description = "Passive. Once per turn, when you unveil a card (any card one of your skills uses), you may activate an Infusion for yourself and your Tethered ally: Potent (a free basic attack), Stalwart (shield 1), Sage (recharge a skill) or Elusive (shift 2). Use Tether (free, once per turn) to choose your ally."
tags = Array[StringName]([&"passive"])
show_on_unit = false
